{
  "info": {
    "name": "ERP Student Dashboard Exam APIs",
    "description": "Postman collection for student dashboard exam-related APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (data && data.token) {",
                  "  pm.collectionVariables.set('studentToken', data.token);",
                  "}",
                  "pm.test('Login success status', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Student Exam V2 (Dashboard Exam Section)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{studentToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get My Published Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v2/student/exam/results?exam_event_id={{exam_event_id}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": "student@example.com"
    },
    {
      "key": "studentPassword",
      "value": "123456"
    },
    {
      "key": "exam_event_id",
      "value": "1"
    }
  ]
}
