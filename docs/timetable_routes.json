{
  "info": {
    "name": "ERP Timetable Routes",
    "description": "Postman collection for all timetable APIs (Admin, Teacher, Student).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Timetable",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Upsert Class Configuration",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/configuration",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_time\": \"08:00\",\n  \"end_time\": \"14:00\",\n  \"period_duration_minutes\": 40,\n  \"break_duration_minutes\": 20,\n  \"break_after_period\": 4,\n  \"working_days\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Class Configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/configuration"
          }
        },
        {
          "name": "Generate Slots",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/slots/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force_regenerate\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/slots"
          }
        },
        {
          "name": "Update Slot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/slots/{{slot_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_label\": \"Period 1\",\n  \"start_time\": \"08:00\",\n  \"end_time\": \"08:40\",\n  \"is_break\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Assign Single Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/entries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_section_id\": {{class_id}},\n  \"day_of_week\": \"Monday\",\n  \"time_slot_id\": {{slot_id}},\n  \"subject_id\": {{subject_id}},\n  \"teacher_id\": {{teacher_id}},\n  \"notes\": \"Algebra\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Day Upsert Entries",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/entries/day-upsert",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_section_id\": {{class_id}},\n  \"day_of_week\": \"Monday\",\n  \"entries\": [\n    {\n      \"time_slot_id\": {{slot_id}},\n      \"subject_id\": {{subject_id}},\n      \"teacher_id\": {{teacher_id}},\n      \"notes\": \"Batch update\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Timetable Entry",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/entries/{{entry_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_section_id\": {{class_id}},\n  \"day_of_week\": \"Monday\",\n  \"time_slot_id\": {{slot_id}},\n  \"subject_id\": {{subject_id}},\n  \"teacher_id\": {{teacher_id}},\n  \"notes\": \"Updated entry\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Timetable Entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/admin/timetable/entries/{{entry_id}}"
          }
        },
        {
          "name": "Check Teacher Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/timetable/conflicts/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_section_id\": {{class_id}},\n  \"day_of_week\": \"Monday\",\n  \"time_slot_id\": {{slot_id}},\n  \"teacher_id\": {{teacher_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Class Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/timetable/classes/{{class_id}}/timetable"
          }
        },
        {
          "name": "Get Teacher Timetable (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/timetable/teachers/{{teacher_id}}/timetable"
          }
        }
      ]
    },
    {
      "name": "Teacher Timetable",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{teacherToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get My Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teacherTimetable/me"
          }
        },
        {
          "name": "Get Class Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teacherTimetable/classes/{{class_id}}"
          }
        },
        {
          "name": "Alias - Get Teacher Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teacherTimetable/getTeacherTimetable"
          }
        },
        {
          "name": "Alias - Get Class Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teacherTimetable/getClassTimetable/{{class_id}}"
          }
        }
      ]
    },
    {
      "name": "Student Timetable",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{studentToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/studentattendance/getTimetable"
          }
        },
        {
          "name": "Alias - Get My Timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/studentattendance/me/timetable"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "class_id",
      "value": "1"
    },
    {
      "key": "slot_id",
      "value": "1"
    },
    {
      "key": "entry_id",
      "value": "1"
    },
    {
      "key": "subject_id",
      "value": "1"
    },
    {
      "key": "teacher_id",
      "value": "1"
    }
  ]
}